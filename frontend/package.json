{
  "name": "seewik-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "test:rules:emulator": "npx --yes firebase-tools@15.28.2 emulators:exec --only firestore,storage --project demo-seewik-rules --config ../firebase.json \"node --test scripts/test-security-rules-emulator.mjs\"",
    "test:firestore-rules": "node scripts/test-firestore-draft-ownership.mjs",
    "test:initiative-rules": "node scripts/test-firestore-initiative-protection.mjs",
    "test:google-write-enforcement": "node scripts/test-google-write-enforcement.mjs",
    "test:production-ownership": "node scripts/test-production-ownership.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "firebase": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
