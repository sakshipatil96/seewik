rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function googleLinked() {
      return request.auth != null
        && request.auth.token.firebase.identities["google.com"] != null
        && request.auth.token.firebase.identities["google.com"].size() > 0;
    }

    match /day1_checks/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if googleLinked() && request.auth.uid == uid
                   && request.resource.size < 1 * 1024 * 1024;
    }
  }
}
